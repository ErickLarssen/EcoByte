# Copie para .env e preencha os valores locais. Nunca versione o .env (DEC-037).

NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/ecobyte

# Origem do frontend aceita nas requisições que alteram dados (DEC-069).
# Padrão fora de produção: http://localhost:3000. Obrigatória em produção.
FRONTEND_URL=http://localhost:3000

# Sessão (DEC-021)
# SESSION_SECRET: obrigatória, mínimo de 32 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Expiração em segundos, renovada a cada uso. Padrão: 604800 (7 dias).
SESSION_MAX_AGE=604800

# Proxies confiáveis à frente do backend (DEC-068).
# 0 em desenvolvimento. Obrigatória em produção, conforme a hospedagem.
TRUST_PROXY=0

# E-mail por SMTP (DEC-082). Obrigatório em produção. Em desenvolvimento, sem
# SMTP_HOST, os e-mails (com os links de confirmação e de redefinição de senha)
# aparecem no console. No plano gratuito do Render, as portas 25, 465 e 587 são
# bloqueadas: use a porta 2525 do provedor, se houver (DEC-086).
SMTP_HOST=
SMTP_PORT=587
# true para TLS direto (porta 465); false usa STARTTLS.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EcoByte <nao-responda@ecobyte.local>

# Consulta de CEP (DEC-081). Padrão: https://viacep.com.br
# VIACEP_URL=https://viacep.com.br

# Inicialização de um banco novo: npm run bootstrap --workspace backend (DEC-087).
# Não são lidas pelo servidor. Cria o primeiro administrador e o ecoponto
# central somente se ainda não existirem; nunca apaga nem altera dados.
# Informe-as só na execução do script, não no serviço publicado.
# BOOTSTRAP_ADMIN_NOME=
# BOOTSTRAP_ADMIN_EMAIL=
# Senha provisória (política do cadastro), trocada no primeiro acesso.
# BOOTSTRAP_ADMIN_SENHA=
# Dados reais do ecoponto (OQ-003). Sem eles, o ecoponto não é criado.
# ECOPONTO_NOME=
# ECOPONTO_DESCRICAO=
# ECOPONTO_LOGRADOURO=
# ECOPONTO_NUMERO=
# ECOPONTO_COMPLEMENTO=
# ECOPONTO_BAIRRO=
# ECOPONTO_CIDADE=
# ECOPONTO_ESTADO=
# ECOPONTO_CEP=
